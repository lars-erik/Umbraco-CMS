{
  "$schema": "./appsettings-schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Umbraco.Cms.Tests": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "Tests": {
    "Database": {
      "DatabaseType": "SQLServer", // "SQLite", "LocalDb"
      "PrepareThreadCount": 4,
      "SchemaDatabaseCount": 4,
      "EmptyDatabasesCount": 2,
      "SQLServerMasterConnectionString": "Server=.\\sqlexpress;Database=master;Integrated Security=SSPI;Trust Server Certificate=True"
    }
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "AllowedUploadedFileExtensions": ["jpg", "png", "gif", "svg", "udt"]
      }
    }
  }
}
